### Schicht 4 — AnbieterAdapter (Modular, selbstkonfigurierend)

**Ein Adapter pro Anbieter-Typ** — nicht pro Anbieter. Der Adapter konfiguriert sich:

```python
class AnbieterAdapter(Protocol):
    """Interface das alle Adapter implementieren."""
    
    def configure(self, schema: DetectedSchema) -> None: ...
    def serialize(self, payload: NormalizedPayload, schema: DetectedSchema) -> dict: ...
    async def send(self, payload: dict, endpoint: EndpointDef) -> AdapterResponse: ...
    def parse_response(self, raw: dict) -> NormalizedResponse: ...

# ─── KONKRETE ADAPTER ──────────────────────────────────────────────────────

class HTMLFormAdapter:
    """
    Für klassische Web-Formulare (Kontakt, Bestellung, Support).
    Erkennt automatisch: multipart/form-data vs application/x-www-form-urlencoded
    Fügt CSRF-Token automatisch ein wenn erkannt.
    """
    
    def configure(self, schema: DetectedSchema) -> None:
        self._encoding = self._detect_encoding(schema)
        self._csrf_field = self._find_csrf_field(schema)
        self._honeypot_fields = self._find_honeypot_fields(schema)
    
    def serialize(self, payload: NormalizedPayload, schema: DetectedSchema) -> dict:
        result = {}
        for field_name, field in payload.fields.items():
            if field.validation_passed:
                result[field.original_name] = field.value
        
        # CSRF automatisch
        if self._csrf_field:
            result[self._csrf_field.name] = self._csrf_token
        
        # Honeypot-Felder leer lassen (Anti-Bot)
        for hp in self._honeypot_fields:
            result[hp.name] = ""
        
        return result

class RESTAdapter:
    """
    Für REST APIs (JSON).
    Konfiguriert sich aus OpenAPI-Schema.
    Unterstützt: Bearer, ApiKey, OAuth2, Basic Auth.
    """
    
    def configure(self, schema: DetectedSchema) -> None:
        self._auth = AuthHandlerFactory.create(schema.auth_method)
        self._base_url = schema.source_url
        self._endpoints = {ep.operation_id: ep for ep in schema.endpoints}
    
    async def send(self, payload: dict, endpoint: EndpointDef) -> AdapterResponse:
        headers = {
            "Content-Type": "application/json",
            "X-Correlation-Id": payload.get("_correlation_id", ""),
        }
        self._auth.inject_headers(headers)
        
        # Rate-Limiting (aus RateLimiter der ResearchEngine übernehmen)
        await self._rate_limiter.wait()
        
        response = await self._http.post(
            url=self._base_url + endpoint.path,
            json=payload,
            headers=headers,
            timeout=30,
        )
        return self._parse_response(response)

class EmailFormAdapter:
    """
    Für E-Mail-basierte Kontaktformulare (mailto:, SMTP, Webmailer).
    Erkennt automatisch ob mailto: oder AJAX-POST.
    """
    
    def configure(self, schema: DetectedSchema) -> None:
        action = schema.form_action
        if action.startswith("mailto:"):
            self._mode = EmailMode.MAILTO
        else:
            self._mode = EmailMode.HTTP_POST
    
    def serialize(self, payload: NormalizedPayload, schema: DetectedSchema) -> dict:
        # Felder zu E-Mail-Körper zusammensetzen
        email_body = self._template.render(payload.fields)
        # WICHTIG: HTML-Escape für E-Mail-Output
        return {"body": html.escape(email_body), "subject": payload.fields.get("subject")}

class GraphQLAdapter:
    """Für GraphQL-Endpunkte. Baut Query/Mutation automatisch aus Schema."""
    
    def configure(self, schema: DetectedSchema) -> None:
        self._schema = schema
        self._mutations = {m.name: m for m in schema.mutations}
    
    def build_mutation(self, operation: str, variables: dict) -> str:
        mutation = self._mutations[operation]
        return f"""
            mutation {mutation.name}($input: {mutation.input_type}!) {{
                {mutation.name}(input: $input) {{
                    {' '.join(mutation.return_fields)}
                }}
            }}
        """
