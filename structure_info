### Schicht 3 — SecurityPipeline (Schutz, unveränderlich)

**Jedes** Datum durchläuft diese Pipeline — keine Ausnahmen:

```python
class SecurityPipeline:
    """
    Mehrschichtige Sicherheitsprüfung.
    Reihenfolge ist kritisch — nicht verändern.
    
    Basiert auf vorhandenen Modulen:
    - ContentPolicy (13 CSP-Violation-Typen)
    - InjectionPatterns (8 Injection-Typen, 50+ Patterns)
    - InputValidator (Email, URL, Phone, IPv4, UUID)
    - ResponseValidator (LLM-Output Validierung)
    """
    
    PIPELINE_STAGES = [
        Stage.LENGTH_CHECK,          # Max-Länge prüfen
        Stage.ENCODING_NORMALIZE,    # Unicode normalisieren (NFKC)
        Stage.UNICODE_ATTACK_DETECT, # Zero-width, RTL-Override
        Stage.INJECTION_SCAN,        # SQL, XSS, Command, Path, Template
        Stage.CSP_VALIDATE,          # Content Security Policy
        Stage.TYPE_COERCE,           # Zu erwartetem Typ konvertieren
        Stage.FIELD_VALIDATE,        # Feldspezifische Regeln (email, url)
        Stage.ENCODE_FOR_OUTPUT,     # HTML-Escape für sicheren Output
    ]
    
    def process(
        self, 
        value: Any, 
        field: FieldDefinition,
        context: SecurityContext,
    ) -> SecurityResult:
        
        result = SecurityResult(value=value)
        
        for stage in self.PIPELINE_STAGES:
            result = self._run_stage(stage, result, field, context)
            if result.rejected:
                # Kein weiterer Schritt — sofort stoppen
                self._event_bus.publish("security.field_rejected", {
                    "field": field.name,
                    "stage": stage.name,
                    "reason": result.rejection_reason,
                    "correlation_id": context.correlation_id,
                })
                return result
        
        return result

class SecurityResult:
    value: Any
    rejected: bool = False
    rejection_reason: str | None = None
    warnings: list[str] = field(default_factory=list)
    transformations_applied: list[str] = field(default_factory=list)

# Was blockiert wird (aus InjectionPatterns):
# XSS:      <script>, javascript:, onclick=, onerror=, data:text/html
# SQL:      ' OR 1=1, UNION SELECT, char(), hex()
# Command:  rm -rf, | cat, $(cmd), backticks
# Path:     ../../../etc/passwd, %2e%2e%2f
# Template: {{code}}, {%exec%}, __import__
# Unicode:  \u200b (zero-width), \u202e (RTL override)
# Prompt:   "ignore previous instructions", "SYSTEM:", jailbreak patterns
