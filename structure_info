## 7. DATA GRABBER — EXTERNES WISSEN EINSAMMELN

```python
class DataGrabber:
    """
    Sammelt strukturierte Informationen von externen Quellen.
    Sicher, rate-limited, gecacht.
    Keine scraping-Verstöße — nur öffentliche, erlaubte Daten.
    """
    
    GRABBER_STRATEGIES = [
        GrabStrategy.OPENAPI_SPEC,       # /openapi.json
        GrabStrategy.ROBOTS_TXT,         # Erlaubte Pfade prüfen
        GrabStrategy.SITEMAP,            # sitemap.xml → Struktur
        GrabStrategy.HTML_FORMS,         # Form-Elemente aus HTML
        GrabStrategy.JSON_LD,            # Strukturierte Daten (schema.org)
        GrabStrategy.META_TAGS,          # Description, Keywords
        GrabStrategy.LINK_HEADERS,       # Link-rel Header (API-Discovery)
    ]
    
    async def grab(self, url: str) -> GrabbedData:
        # robots.txt IMMER zuerst prüfen
        allowed = await self._check_robots(url)
        if not allowed:
            return GrabbedData.not_allowed(url)
        
        results = await asyncio.gather(*[
            self._apply_strategy(strategy, url)
            for strategy in self.GRABBER_STRATEGIES
        ])
        
        merged = self._merge(results)
        
        # In Gene umwandeln + cachen
        gene = self._assemble_gene_from_grabbed(merged)
        self._genome.gene_index.add(gene)
        
        return merged

@dataclass
class GrabbedData:
    url: str
    forms: list[FormSchema]
    api_endpoints: list[EndpointDef]
    structured_data: dict              # JSON-LD schema.org
    meta: dict                        # Title, Description etc.
    robots_allowed: bool
    cache_ttl: int                    # Wie lange gültig (Sekunden)
    gene_id: str | None               # Erzeugtes/gefundenes Gene
```

