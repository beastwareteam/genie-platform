### Schicht 2 — DataFabricEngine (Normalisierung)

Transformiert **jede externe Datenstruktur** in das interne Format — und zurück:

```python
class DataFabricEngine:
    """
    Bidirektionaler Übersetzer:
    Extern (chaos) ↔ Intern (normalisiert) ↔ Extern (anbieter-spezifisch)
    """
    
    def normalize_inbound(
        self, 
        raw_data: dict,
        schema: DetectedSchema,
        security_context: SecurityContext,
    ) -> NormalizedPayload:
        """Externe Daten → sicheres internes Format."""
        
        result = {}
        for field in schema.fields:
            raw_value = raw_data.get(field.name)
            
            # Sicherheits-Pipeline (unveränderlich, immer)
            secured = self._security_pipeline.process(
                value=raw_value,
                field=field,
                context=security_context,
            )
            
            result[field.name] = NormalizedField(
                original_name=field.name,
                value=secured.value,
                field_type=field.field_type,
                validation_passed=secured.valid,
                security_class=field.security_class,
            )
        
        return NormalizedPayload(fields=result, schema_id=schema.gene_id)
    
    def serialize_outbound(
        self,
        payload: NormalizedPayload,
        target_schema: DetectedSchema,
        adapter: "AnbieterAdapter",
    ) -> dict:
        """Internes Format → anbieter-spezifisches Format."""
        return adapter.serialize(payload, target_schema)

@dataclass
class NormalizedField:
    original_name: str
    value: Any                       # Bereinigter, validierter Wert
    field_type: FieldType
    validation_passed: bool
    security_class: SecurityClass
    
@dataclass  
class NormalizedPayload:
    fields: dict[str, NormalizedField]
    schema_id: str | None
    created_at: datetime
    correlation_id: str              # Für Tracing
```

