### Schicht 5 — AdaptiveLearning (Selbsterweiterung)

Das System lernt aus jeder erfolgreichen Interaktion:

```python
class AdaptiveLearningEngine:
    """
    Jede erfolgreiche API-Interaktion → neues/verbessertes Gene.
    Jeder Fehler → Edge Case Eintrag.
    Nach N Interaktionen → Muster werden automatisch generalisiert.
    """
    
    def record_success(
        self,
        source: DetectionSource,
        schema: DetectedSchema,
        adapter: AnbieterAdapter,
        response: AdapterResponse,
    ) -> None:
        # Gen erzeugen oder bestehenes verbessern
        existing_gene = self._genome.gene_index.lookup_by_domain(source.domain)
        
        if existing_gene.is_hit:
            # Fitness erhöhen
            self._genome.improve(existing_gene.gene.id, feedback=+0.8)
        else:
            # Neues Gene aus erfolgreicher Interaktion erzeugen
            gene = self._assemble_from_interaction(source, schema, adapter)
            self._genome.gene_index.add(gene)
        
        # Pattern in EdgeCaseMatrix speichern
        self._edge_case_matrix.record(
            key=(schema.schema_type, frozenset(schema.security_requirements)),
            pattern=adapter.get_config_snapshot(),
        )
    
    def record_failure(
        self,
        source: DetectionSource,
        error: AdapterError,
        context: dict,
    ) -> None:
        # Fehler als Edge Case speichern
        self._edge_case_matrix.record_failure(
            domain=source.domain,
            error_type=error.type,
            context=context,
        )
        
        # LLM um Lösung bitten
        fix = self._query_engine.run_turn(
            FIX_PROMPT.format(
                error=error.message,
                schema=context.get("schema"),
                attempted=context.get("payload"),
            )
        )
        
        # Lösung als neues Gen speichern
        self._genome.create_fix_gene(source.domain, fix.output)
    
    def generalize_patterns(self) -> None:
        """
        Läuft periodisch (z.B. alle 100 Interaktionen).
        Findet gemeinsame Muster über viele Domains.
        Erstellt generalisierte Gene (z.B. "kontaktformular-standard").
        """
        clusters = self._pattern_clusterer.cluster(
            self._interaction_log.recent(limit=100)
        )
        for cluster in clusters:
            if cluster.size >= 5:  # Mindestens 5 ähnliche Fälle
                generalized_gene = self._generalize(cluster)
                self._genome.gene_index.add(generalized_gene)
