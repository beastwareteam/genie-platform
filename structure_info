### Schicht 1 — SchemaDetector (Erkennung)

Analysiert eine externe URL/Formular/API automatisch und erkennt die Struktur:

```python
class SchemaDetector:
    """
    Gibt eine URL rein → bekommt ein normalisiertes Schema raus.
    Keine manuelle Konfiguration nötig.
    """
    
    async def detect(self, source: DetectionSource) -> DetectedSchema:
        results = await asyncio.gather(
            self._detect_html_form(source),      # Formular-Felder aus HTML
            self._detect_openapi(source),         # OpenAPI/Swagger Spec
            self._detect_graphql(source),         # GraphQL Introspection
            self._detect_rest_patterns(source),   # REST Heuristiken
            self._detect_from_gene_cache(source), # Bekanntes Muster?
        )
        return self._merge_detections(results)

@dataclass
class DetectedSchema:
    source_url: str
    schema_type: SchemaType          # FORM, REST, GRAPHQL, EMAIL, SOAP
    fields: list[FieldDefinition]    # Erkannte Felder mit Typ/Validierung
    endpoints: list[EndpointDef]     # Erkannte Endpunkte
    auth_method: AuthMethod          # NONE, APIKEY, BEARER, OAUTH, CSRF
    security_requirements: list[str] # CORS, CSRF-Token, etc.
    confidence: float                # 0.0 - 1.0
    gene_id: str | None              # Falls Muster bekannt → Gene laden

@dataclass  
class FieldDefinition:
    name: str
    field_type: FieldType            # TEXT, EMAIL, NUMBER, SELECT, FILE, HIDDEN
    required: bool
    validation_pattern: str | None   # Regex aus HTML `pattern` Attribut
    label: str                       # Aus Label-Tag extrahiert
    placeholder: str
    options: list[str]               # Für SELECT-Felder
    security_class: SecurityClass    # SAFE, SANITIZE, ENCODE, REJECT
```

**Erkennungs-Strategien:**

```python
class HTMLFormDetector:
    """Lädt HTML, parst alle <form> Elemente."""
    
    async def detect(self, url: str) -> FormSchema:
        html = await self._safe_fetch(url)
        # CSP-Prüfung des empfangenen HTML
        csp_result = self._content_policy.validate_content(html)
        if not csp_result.safe:
            raise SecurityViolation(csp_result.violations)
        
        soup = self._parse(html)
        forms = soup.find_all("form")
        return [self._extract_form_schema(f) for f in forms]

class OpenAPIDetector:
    """Versucht /openapi.json, /swagger.json, /api-docs."""
    
    COMMON_PATHS = ["/openapi.json", "/swagger.json", "/api-docs", 
                    "/v1/openapi.json", "/.well-known/openapi.json"]
    
    async def detect(self, base_url: str) -> OpenAPISchema | None:
        for path in self.COMMON_PATHS:
            schema = await self._try_fetch_json(base_url + path)
            if schema and "openapi" in schema:
                return self._parse_openapi(schema)
        return None

class PatternLearner:
    """Lernt Muster aus vergangenen erfolgreichen Integrationen."""
    
    def recognize(self, url: str) -> GeneId | None:
        # URL-Hash → bekanntes Gene?
        domain = self._extract_domain(url)
        return self._pattern_store.lookup_by_domain(domain)
